# Compat harness: assembled server instances are regenerable artifacts
# (compat/validate.py assemble() rebuilds them cold on every run) — never
# commit server worlds or stale mod jars; a committed jar once shadowed a
# fresh build in the instance mods dir.
compat/instances/
compat/cache/
compat/__pycache__/
compat/*.stdout.log

# Dev-run logs (./gradlew :fabric:runServer artifacts)
fabric/logs/
